<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_salsa"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- Ties the app to the site for the TWA; the site's half is /.well-known/assetlinks.json. -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <!--
            One launcher per dance, each its own task so both can sit in Recents.
            androidbrowserhelper's LauncherActivity opens DEFAULT_URL (or the
            intent's data, when the app itself opens a page) in a Trusted Web
            Activity: Chrome, full screen.
        -->
        <activity
            android:name=".SalsaLauncher"
            android:exported="true"
            android:icon="@mipmap/ic_salsa"
            android:label="@string/salsa"
            android:taskAffinity="eu.anotherroot.salsa.dance.salsa">
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/salsa_url" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/salsa" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BachataLauncher"
            android:exported="true"
            android:icon="@mipmap/ic_bachata"
            android:label="@string/bachata"
            android:taskAffinity="eu.anotherroot.salsa.dance.bachata">
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/bachata_url" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/bachata" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
