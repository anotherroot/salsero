<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The WebView screen: no action bar, and the page's colour before it loads.
        DayNight, not Light: WebView takes prefers-color-scheme from the app's
        theme, so a Light theme would keep the page light in night mode.
    -->
    <style name="Shell" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/plane</item>
    </style>
</resources>
