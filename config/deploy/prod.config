# Production deploy target for salsaapp.
#
# Sourced by scripts/deploy.sh. Shell syntax, committed — nothing secret lives
# here. Runtime secrets are agenix on the box (see docs/deployment.md).

SERVER_USER="tilen"
SERVER_HOST="49.13.76.224"          # the 'cloud' host, flake attr my-hetzner-vm

# Created by systemd.tmpfiles in the NixOS host config, owned by the service
# user. The deploy will refuse to run if it does not exist yet.
SERVER_PATH="/var/lib/salsa/app"

# Declared in the NixOS host config (modules/services/salsa.nix); the deploy
# only restarts it.
SERVICE_NAME="salsa"
SERVICE_USER="salsa"

# Loopback port the node process binds; nginx proxies to it. The registry of
# taken ports is nixos-config modules/services/ports.nix.
APP_PORT="3060"

PUBLIC_HOST="salsa.anotherroot.eu"
